{
  "name": "hassanos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test": "tsx --test tests/*.test.ts && node --conditions=react-server --import tsx --test tests/database/csv.test.ts tests/server/*.test.ts",
    "test:db": "node --conditions=react-server --import tsx --test --test-concurrency=1 tests/database/baseline.test.ts tests/database/workflow.test.ts tests/database/outreach.test.ts tests/database/opportunities.test.ts tests/database/discovery.test.ts tests/database/business-discovery.test.ts tests/database/contact-research.test.ts"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.5.0",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^1.62.0",
    "next": "16.4.3",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "robots-parser": "^3.0.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
